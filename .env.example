# Ambiente local do backend. Em produção, defina APP_ENV=production e gere uma chave própria.
APP_ENV=development
SECRET_KEY=troque-esta-chave-local-por-uma-secreta-com-mais-de-32-caracteres
DATABASE_URL=sqlite:///./seha.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Copie este valor para frontend/.env.local; no deploy use a URL HTTPS do backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# PostgreSQL opcional: postgresql+psycopg://USUARIO:SENHA@HOST:5432/BANCO?sslmode=require
